<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>VEXA Admin Panel</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
body{
  background:#0b0f1a;
  color:white;
  font-family:Arial;
  padding:30px;
}
h2{
  color:#00e5ff;
}
table{
  width:100%;
  border-collapse:collapse;
  margin-bottom:30px;
}
th,td{
  border:1px solid #222;
  padding:8px;
  text-align:center;
}
th{
  background:#11182b;
}
</style>
</head>

<body>

<h1>👑 VEXA ADMIN DASHBOARD</h1>

<h2>All Users</h2>
<table id="usersTable">
<tr>
<th>Email ID</th>
<th>Balance</th>
<th>Level</th>
</tr>
</table>

<h2>Withdrawal Requests</h2>
<table id="withdrawTable">
<tr>
<th>User ID</th>
<th>Amount</th>
<th>Wallet</th>
<th>Status</th>
</tr>
</table>

<script>

const supabaseClient = window.supabase.createClient(
  'https://qmcjmnugpujsqabqejpx.supabase.co',
  'sb_publishable_iJ0Xgceyxde4ZnAXeRHcqQ_wNzyi4iq'
);

loadUsers();
loadWithdrawals();

async function loadUsers(){

  const { data } = await supabaseClient
    .from('users')
    .select('*');

  const table = document.getElementById("usersTable");

  data.forEach(user => {
    table.innerHTML += `
      <tr>
        <td>${user.username}</td>
        <td>${user.balance}</td>
        <td>${user.level}</td>
      </tr>
    `;
  });
}

async function loadWithdrawals(){

  const { data } = await supabaseClient
    .from('withdrawals')
    .select('*');

  const table = document.getElementById("withdrawTable");

  data.forEach(w => {
    table.innerHTML += `
      <tr>
        <td>${w.user_id}</td>
        <td>${w.amount}</td>
        <td>${w.wallet}</td>
        <td>${w.status}</td>
      </tr>
    `;
  });
}

</script>

</body>
</html>
